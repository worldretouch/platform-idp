# Platform Service — Environment Variables
# Copy to .env and configure. Never commit .env.
# See docs/SERVICE-CONTRACT.md for full contract.

# === REQUIRED (all services) ===
PORT=3000
APP_ENV=development

# === OPTIONAL (logging) ===
LOG_LEVEL=info

# === DATABASE (if service uses PostgreSQL) ===
DATABASE_URL=postgres://user:password@localhost:5432/service_db

# === CACHE (if service uses Redis) ===
REDIS_URL=redis://localhost:6379/0

# === MESSAGE BROKER (if service uses RabbitMQ) ===
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# === SERVICE-SPECIFIC (add as needed, use SCREAMING_SNAKE_CASE) ===
# MY_SERVICE_API_KEY=
# MY_SERVICE_WEBHOOK_SECRET=
